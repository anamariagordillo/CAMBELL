# Copia este archivo como .env y ajusta los valores. NO subas .env a Git.

# Seguridad
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: sqlite (por defecto) o mysql
DB_ENGINE=sqlite
# Solo si DB_ENGINE=mysql:
DB_NAME=cambell
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo (recuperacion de contrasena). Si se deja vacio, los correos salen en la consola.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Seguridad de las cuentas
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15
HORAS_TOKEN_RECUPERACION=1

# Suscripción premium (pago simulado)
COSTO_SUSCRIPCION_MENSUAL=19900
# 1.0 = siempre aprueba el pago simulado; 0.0 = siempre lo rechaza (útil para probar).
PROBABILIDAD_PAGO_APROBADO=1.0

# Verificacion facial (opcional). Sin credenciales se usa la revision manual.
# Si defines ambas claves se usa la estrategia Face++.
FACEPP_API_KEY=
FACEPP_API_SECRET=
# Solo si Face++ te da otra URL regional:
# FACEPP_API_URL=https://api-us.faceplusplus.com/facepp/v3/compare
UMBRAL_VERIFICACION_FACIAL=75

# Tareas programadas (python manage.py tareas_programadas)
HORAS_REASIGNACION=1
HORAS_SOLICITUD_NO_ATENDIDA=24
UMBRAL_REPORTES_SUSPENSION=3
DIAS_AVISO_DOCUMENTO=30
DIAS_RECORDATORIO_CALIFICACION=2
DIAS_AVISO_SUSCRIPCION=7
DIAS_RETENCION_ARCHIVOS=365
